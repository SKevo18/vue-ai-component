{
  "name": "@skevo18/vue-ai-component",
  "version": "0.1.0",
  "description": "Browser AI harness and chat sidebar for Vue 3 apps, wired to an MCP server.",
  "license": "MIT",
  "repository": "github:SKevo18/vue-ai-component",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "import": "./dist/code.js"
    },
    "./code/worker": {
      "types": "./dist/code/worker/index.d.ts",
      "import": "./dist/code-worker.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./code-assets": {
      "types": "./dist/code-assets.d.ts",
      "import": "./dist/code-assets.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vite build --config vite.workers.config.ts && WORKER=python vite build --config vite.workers.config.ts && vue-tsc -p tsconfig.build.json",
    "check": "vue-tsc -p tsconfig.json --noEmit && vitest run",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.52.0",
    "pyodide": ">=314.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "pyodide": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@lucide/vue": "^1.66.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "pyodide": "314.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
